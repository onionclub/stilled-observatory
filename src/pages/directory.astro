---
import Layout from '../layouts/Layout.astro';
import Head from '../components/Head.astro';
const desc = 'Index of external sources, tools, and recommended reading.';
---

<Layout title="Stilled | Directory">
  <Head slot="head" title="Stilled | Directory" description={desc} />
  <link rel="stylesheet" href="/mouse-follower.css" />

  <div class="mesh-layer" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
  </div>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="micro micro-tl" aria-hidden="true">DIRECTORY</div>
  <div class="micro micro-tr" aria-hidden="true">SOURCES</div>

  <section class="page">
    <header class="page-header reveal">
      <span class="mark" aria-hidden="true"></span>
      <h1>Directory</h1>
      <p class="sub">Index of external sources, tools, and recommended reading.</p>
    </header>
    <ul class="list">
      <li class="reveal"><a href="#" class="entry" data-cursor-text="View"><span class="idx">01</span><span class="title">The Structure of Scientific Revolutions</span><span class="author">Thomas S. Kuhn</span></a></li>
      <li class="reveal delay-1"><a href="#" class="entry" data-cursor-text="View"><span class="idx">02</span><span class="title">Man's Search for Meaning</span><span class="author">Viktor E. Frankl</span></a></li>
      <li class="reveal delay-2"><a href="#" class="entry" data-cursor-text="View"><span class="idx">03</span><span class="title">Thinking, Fast and Slow</span><span class="author">Daniel Kahneman</span></a></li>
    </ul>
  </section>
</Layout>

<style>
  body { background: var(--paper-deep); color: var(--ink); overflow-x: hidden; }

  .mesh-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(130px); animation: drift 24s ease-in-out infinite; }
  .blob-1 { width: 45vw; height: 45vw; background: var(--mesh-2); top: -15%; right: -10%; animation-delay: 0s; }
  .blob-2 { width: 35vw; height: 35vw; background: var(--mesh-4); bottom: -10%; left: -5%; animation-delay: -10s; }
  @keyframes drift { 0%,100%{transform:translate(0,0) scale(1)} 25%{transform:translate(5%,-8%) scale(1.1)} 50%{transform:translate(-3%,5%) scale(0.92)} 75%{transform:translate(-6%,-3%) scale(1.05)} }

  .grid-lines { position: fixed; inset: 0; z-index: 1; pointer-events: none; background-image: linear-gradient(var(--border-hairline) 1px,transparent 1px),linear-gradient(90deg,var(--border-hairline) 1px,transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 50% 40% at 50% 50%,black 15%,transparent 60%); }

  .micro { position: fixed; z-index: var(--z-above); font-family: var(--font-mono,monospace); font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; opacity: 0.35; pointer-events: none; color: var(--ink-dim); }
  .micro-tl { top: 1.2rem; left: 1.5rem; }
  .micro-tr { top: 1.2rem; right: 1.5rem; }

  .page { padding: var(--page-pad-top) var(--page-pad-x) var(--page-pad-bottom); position: relative; z-index: 2; }
  .page-header { margin-bottom: var(--space-4xl); }
  .page-header .mark { display: block; width: 32px; height: 1px; background: var(--accent); margin-bottom: var(--space-lg); opacity: 0.5; }
  .page-header h1 { font-size: var(--text-display); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tightest); margin-bottom: var(--space-md); }
  .sub { font-size: var(--text-lead); color: var(--ink-dim); max-width: var(--measure-narrow); }
  .list { list-style: none; max-width: var(--measure-wide); }
  .entry { display: flex; align-items: baseline; padding: var(--space-xl) 0; border-bottom: 1px solid var(--border-hairline); transition: opacity 0.35s, padding 0.4s, background 0.4s; border-radius: 2px; }
  .entry:hover { opacity: 0.5; padding-left: var(--space-xs); background: var(--accent-soft); margin: 0 calc(-1 * var(--space-xs)); padding-right: var(--space-xs); }
  .idx { font-size: var(--text-label); opacity: 0.25; width: 4rem; flex-shrink: 0; font-family: var(--font-mono,monospace); }
  .title { font-family: var(--font-serif); font-size: var(--text-h2); flex: 1; }
  .author { font-size: var(--text-label); text-transform: uppercase; letter-spacing: var(--tracking-label); opacity: 0.45; text-align: right; }
  .delay-1 { transition-delay: 0.08s; }
  .delay-2 { transition-delay: 0.16s; }
  @media (max-width: 600px) { .entry { flex-direction: column; gap: var(--space-xs); } .idx { width: auto; } .author { text-align: left; } .micro { display: none; } }
</style>
