---
import Layout from '../layouts/Layout.astro';
import Head from '../components/Head.astro';
import services from '../data/counsel-services.js';

const desc = 'Email counseling — precision instruments for the examined life. Private, forensic, one-on-one correspondence.';
---

<Layout title="Stilled | Counsel">
  <Head slot="head" title="Stilled | Counsel" description={desc} />

  <div class="mesh-layer" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
  </div>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="micro micro-tl" aria-hidden="true">COUNSEL</div>
  <div class="micro micro-tr" aria-hidden="true">SERVICES</div>

  <section class="page">
    <header class="page-header reveal">
      <span class="mark" aria-hidden="true"></span>
      <h1>Counsel</h1>
      <p class="sub">{desc}</p>
    </header>

    <div class="services">
      {services.map((s, i) => (
        <article class={`service reveal delay-${i}`}>
          {s.badge && <span class="badge">{s.badge}</span>}
          <h2 class="name">{s.name}</h2>
          <p class="tagline">{s.tagline}</p>
          <p class="price">{s.price}</p>
          <ul class="features">
            {s.features.map(f => <li>{f}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="form-section reveal">
      <hr class="rule" />
      <h2 class="form-heading">Inquire</h2>
      <p class="form-sub">Tell me what you are navigating. No cost to inquire.</p>
      <form
        class="form"
        action="https://formspree.io/f/your-form-id"
        method="POST"
      >
        <label class="field">
          <span class="field-label">Name</span>
          <input type="text" name="name" required placeholder="Your name" />
        </label>
        <label class="field">
          <span class="field-label">Email</span>
          <input type="email" name="email" required placeholder="you@example.com" />
        </label>
        <label class="field">
          <span class="field-label">Service</span>
          <select name="service">
            <option value="">Select a service tier...</option>
            {services.map(s => (
              <option value={s.slug}>{s.name} — {s.price}</option>
            ))}
          </select>
        </label>
        <label class="field">
          <span class="field-label">What brings you here?</span>
          <textarea name="message" rows="4" required placeholder="Describe your situation, question, or impasse..."></textarea>
        </label>
        <button type="submit" class="btn">Send Inquiry</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  body { background: var(--paper-deep); color: var(--ink); overflow-x: hidden; }

  .mesh-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(130px); animation: drift 24s ease-in-out infinite; }
  .blob-1 { width: 40vw; height: 40vw; background: var(--mesh-3); top: -10%; right: -10%; animation-delay: 0s; }
  .blob-2 { width: 30vw; height: 30vw; background: var(--mesh-2); bottom: -10%; left: -5%; animation-delay: -11s; }
  @keyframes drift { 0%,100%{transform:translate(0,0) scale(1)} 25%{transform:translate(4%,-6%) scale(1.08)} 50%{transform:translate(-2%,4%) scale(0.94)} 75%{transform:translate(-5%,-2%) scale(1.04)} }

  .grid-lines { position: fixed; inset: 0; z-index: 1; pointer-events: none; background-image: linear-gradient(var(--border-hairline) 1px,transparent 1px),linear-gradient(90deg,var(--border-hairline) 1px,transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 50% 40% at 50% 50%,black 15%,transparent 60%); }

  .micro { position: fixed; z-index: var(--z-above); font-family: var(--font-mono,monospace); font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; opacity: 0.35; pointer-events: none; color: var(--ink-dim); }
  .micro-tl { top: 1.2rem; left: 1.5rem; }
  .micro-tr { top: 1.2rem; right: 1.5rem; }

  /* ── Page Header ─────────────────────── */
  .page { padding: var(--page-pad-top) var(--page-pad-x) var(--page-pad-bottom); max-width: var(--measure-wide); margin: 0 auto; position: relative; z-index: 2; }
  .page-header { margin-bottom: var(--space-4xl); }
  .page-header .mark { display: block; width: 32px; height: 1px; background: var(--accent); margin-bottom: var(--space-lg); opacity: 0.5; }
  .page-header h1 { font-size: var(--text-display); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tightest); margin-bottom: var(--space-md); }
  .sub { font-size: var(--text-lead); color: var(--ink-dim); max-width: var(--measure-narrow); }

  /* ── Service Cards ───────────────────── */
  .services { display: flex; flex-direction: column; gap: var(--space-2xl); margin-bottom: var(--space-4xl); }

  .service {
    border: 1px solid var(--border-hairline);
    padding: var(--space-2xl);
    position: relative;
    transition: border-color 0.45s ease, box-shadow 0.45s ease;
  }
  .service:hover {
    border-color: var(--glass-border-glow);
    box-shadow: var(--shadow-glow-accent);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }

  .badge {
    display: inline-block;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    padding: 0.15em 0.75em;
    margin-bottom: var(--space-md);
  }

  .name { font-size: var(--text-h1); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-xs); }
  .tagline { font-size: var(--text-lead); color: var(--ink-dim); margin-bottom: var(--space-md); font-style: italic; }
  .price {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    color: var(--accent);
    margin-bottom: var(--space-lg);
    letter-spacing: var(--tracking-tight);
  }

  .features { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .features li {
    font-size: var(--text-body);
    color: var(--ink-dim);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-lg);
    position: relative;
  }
  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 1px;
    background: var(--accent);
    opacity: 0.5;
  }

  /* ── Form Section ────────────────────── */
  .form-section { }
  .rule { border: 0; height: 1px; background: var(--border-hairline); margin-bottom: var(--space-2xl); }
  .form-heading { font-size: var(--text-h2); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-xs); }
  .form-sub { font-size: var(--text-body); color: var(--ink-dim); margin-bottom: var(--space-xl); }

  .form { display: flex; flex-direction: column; gap: var(--space-xl); }
  .field { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .field-label { font-size: var(--text-label); text-transform: uppercase; letter-spacing: var(--tracking-label); opacity: 0.45; }
  input, textarea, select {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-thin);
    padding: var(--space-sm) 0;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--ink);
    transition: border-color 0.4s ease;
    outline: none;
    resize: vertical;
    border-radius: 0;
  }
  select { cursor: pointer; }
  select option { background: var(--paper-deep); color: var(--ink); }
  input:focus, textarea:focus, select:focus { border-color: var(--accent); }
  input::placeholder, textarea::placeholder { color: var(--ink-faint); }

  .btn {
    align-self: flex-start;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--border-thin);
    padding: var(--space-sm) var(--space-2xl);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    cursor: pointer;
    transition: all 0.4s ease;
    border-radius: 2px;
  }
  .btn:hover { border-color: var(--accent); box-shadow: var(--shadow-glow-accent); }

  .delay-0 { transition-delay: 0s; }
  .delay-1 { transition-delay: 0.1s; }
  .delay-2 { transition-delay: 0.2s; }

  @media (max-width: 600px) {
    .service { padding: var(--space-xl); }
    .micro { display: none; }
  }
</style>
