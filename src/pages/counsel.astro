---
import Layout from '../layouts/Layout.astro';
import Head from '../components/Head.astro';
import services, { addOns } from '../data/counsel-services.js';

const desc = 'Quiet, deliberate written guidance for internal clarity, assumption, and self-concept. Asynchronous, essay-style consultations — no live calls or scheduling required.';
---

<Layout title="Stilled | Counsel">
  <Head slot="head" title="Stilled | Counsel" description={desc} />

  <div class="mesh-layer" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
  </div>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="micro micro-tl" aria-hidden="true">COUNSEL</div>
  <div class="micro micro-tr" aria-hidden="true">SERVICES</div>

  <section class="page">
    <header class="page-header reveal">
      <span class="mark" aria-hidden="true"></span>
      <h1>Counsel</h1>
      <p class="sub">{desc}</p>
    </header>

    <!-- How It Works -->
    <div class="how-it-works reveal">
      <div class="steps">
        <div class="step"><span class="step-num">1</span><span>Choose a service</span></div>
        <div class="step-sep" aria-hidden="true">→</div>
        <div class="step"><span class="step-num">2</span><span>Pay securely via Stripe</span></div>
        <div class="step-sep" aria-hidden="true">→</div>
        <div class="step"><span class="step-num">3</span><span>Receive instructions by email</span></div>
      </div>
    </div>

    <!-- Services -->
    <div class="services">
      {services.map((s, i) => (
        <article class={`service reveal delay-${i}`} id={`svc-${s.slug}`}>
          {s.badge && <span class="badge">{s.badge}</span>}
          <h2 class="name">{s.name}</h2>
          <p class="tagline">{s.tagline}</p>
          <p class="price">{s.price}</p>
          {s.note && <p class="note">{s.note}</p>}
          <p class="overview">{s.overview}</p>
          <ul class="features">
            {s.features.map(f => <li>{f}</li>)}
          </ul>
          {s.slug !== 'monthly-rhythm' && (
            <div class="addon-checks">
              {addOns.map(a => (
                <label class="addon-check">
                  <input type="checkbox" name={`addon-${s.slug}`} value={a.slug} data-service={s.slug} />
                  <span class="addon-check-label">{a.name} <span class="addon-check-price">{a.price}</span></span>
                </label>
              ))}
            </div>
          )}
          <button class="order-btn" data-service={s.slug}>Purchase — {s.price}</button>
        </article>
      ))}
    </div>

    <!-- Add-Ons -->
    <section class="addons reveal">
      <hr class="rule" />
      <h2 class="section-heading">Consultation Add‑Ons</h2>
      <p class="section-sub">Available with any written consultation. Select during checkout.</p>
      <div class="addon-grid">
        {addOns.map(a => (
          <div class="addon-card">
            <h3 class="addon-name">{a.name}</h3>
            <p class="addon-price">{a.price}</p>
            <p class="addon-desc">{a.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Checkout -->
    <div class="form-section reveal" id="checkout">
      <hr class="rule" />
      <h2 class="section-heading">Ready to order?</h2>
      <p class="section-sub">Click any <em>Purchase</em> button above. You'll be redirected to Stripe's secure checkout. After payment, you'll receive an email with the inquiry address and next steps.</p>

      <div class="checkout-note">
        <p><strong>How it works:</strong> Pay → receive email with inquiry address → send your situation → get your written response within 3 business days. Simple, private, no account needed.</p>
      </div>

      <div id="checkout-error" class="checkout-error" style="display:none;"></div>
    </div>
  </section>
</Layout>

<style>
  body { background: var(--paper-deep); color: var(--ink); overflow-x: hidden; }

  .mesh-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(130px); animation: drift 24s ease-in-out infinite; }
  .blob-1 { width: 40vw; height: 40vw; background: var(--mesh-3); top: -10%; right: -10%; animation-delay: 0s; }
  .blob-2 { width: 30vw; height: 30vw; background: var(--mesh-2); bottom: -10%; left: -5%; animation-delay: -11s; }
  @keyframes drift { 0%,100%{transform:translate(0,0) scale(1)} 25%{transform:translate(4%,-6%) scale(1.08)} 50%{transform:translate(-2%,4%) scale(0.94)} 75%{transform:translate(-5%,-2%) scale(1.04)} }

  .grid-lines { position: fixed; inset: 0; z-index: 1; pointer-events: none; background-image: linear-gradient(var(--border-hairline) 1px,transparent 1px),linear-gradient(90deg,var(--border-hairline) 1px,transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 50% 40% at 50% 50%,black 15%,transparent 60%); }

  .micro { position: fixed; z-index: var(--z-above); font-family: var(--font-mono,monospace); font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; opacity: 0.35; pointer-events: none; color: var(--ink-dim); }
  .micro-tl { top: 1.2rem; left: 1.5rem; }
  .micro-tr { top: 1.2rem; right: 1.5rem; }

  .page { padding: var(--page-pad-top) var(--page-pad-x) var(--page-pad-bottom); max-width: var(--measure-wide); margin: 0 auto; position: relative; z-index: 2; }
  .page-header { margin-bottom: var(--space-2xl); }
  .page-header .mark { display: block; width: 32px; height: 1px; background: var(--accent); margin-bottom: var(--space-lg); opacity: 0.5; }
  .page-header h1 { font-size: var(--text-display); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tightest); margin-bottom: var(--space-md); }
  .sub { font-size: var(--text-lead); color: var(--ink-dim); max-width: var(--measure-narrow); }

  /* ── How It Works ───────────────────── */
  .how-it-works { margin-bottom: var(--space-3xl); }
  .steps {
    display: flex; align-items: center; gap: var(--space-md);
    flex-wrap: wrap; justify-content: center;
  }
  .step {
    display: flex; align-items: center; gap: var(--space-sm);
    font-size: var(--text-caption); color: var(--ink-dim);
  }
  .step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem;
    border: 1px solid var(--accent-soft);
    font-size: var(--text-label); font-weight: var(--weight-medium);
    color: var(--accent); flex-shrink: 0;
  }
  .step-sep { color: var(--ink-faint); font-size: var(--text-label); }

  /* ── Service Cards ─────────────────── */
  .services { display: flex; flex-direction: column; gap: var(--space-2xl); margin-bottom: var(--space-3xl); }

  .service {
    border: 1px solid var(--border-hairline);
    padding: var(--space-2xl);
    position: relative;
    transition: border-color 0.45s ease, box-shadow 0.45s ease, background 0.45s ease;
  }
  .service:hover {
    border-color: var(--glass-border-glow);
    box-shadow: var(--shadow-glow-accent);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }

  .badge {
    display: inline-block;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    padding: 0.15em 0.75em;
    margin-bottom: var(--space-md);
  }
  .name { font-size: var(--text-h1); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-xs); }
  .tagline { font-size: var(--text-lead); color: var(--ink-dim); margin-bottom: var(--space-md); font-style: italic; }
  .price {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    color: var(--accent);
    margin-bottom: var(--space-sm);
    letter-spacing: var(--tracking-tight);
  }
  .note { font-size: var(--text-caption); color: var(--ink-dim); font-style: italic; margin-bottom: var(--space-lg); opacity: 0.7; }
  .overview {
    font-size: var(--text-body);
    color: var(--ink);
    margin-bottom: var(--space-lg);
    line-height: var(--leading-relaxed);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-hairline);
  }
  .features { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-xl); }
  .features li {
    font-size: var(--text-body);
    color: var(--ink-dim);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-lg);
    position: relative;
  }
  .features li::before {
    content: '';
    position: absolute; left: 0; top: 0.65em;
    width: 6px; height: 1px;
    background: var(--accent); opacity: 0.5;
  }

  .order-btn {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-size: var(--text-label); text-transform: uppercase;
    letter-spacing: var(--tracking-label); color: var(--accent);
    font-weight: var(--weight-medium);
    padding-bottom: 0.25rem; border-bottom: 1px solid var(--accent);
    transition: opacity 0.35s, border-color 0.35s;
  }
  .order-btn:hover { opacity: 0.7; border-color: transparent; }

  .addon-checks {
    display: flex; flex-direction: column; gap: var(--space-xs);
    margin-bottom: var(--space-lg); padding-top: var(--space-md);
    border-top: 1px solid var(--border-hairline);
  }
  .addon-check {
    display: flex; align-items: center; gap: var(--space-sm);
    cursor: pointer; font-size: var(--text-caption);
  }
  .addon-check input[type="checkbox"] {
    accent-color: var(--accent); width: auto;
  }
  .addon-check-label { color: var(--ink-dim); }
  .addon-check-price {
    font-family: var(--font-mono); font-size: var(--text-caption);
    color: var(--accent);
  }

  /* ── Add-Ons ───────────────────────── */
  .addons { margin-bottom: var(--space-3xl); }
  .rule { border: 0; height: 1px; background: var(--border-hairline); margin-bottom: var(--space-2xl); }
  .section-heading { font-size: var(--text-h2); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-xs); }
  .section-sub { font-size: var(--text-body); color: var(--ink-dim); margin-bottom: var(--space-xl); }
  .addon-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
  .addon-card {
    border: 1px solid var(--border-hairline);
    padding: var(--space-lg);
    transition: border-color 0.35s, box-shadow 0.35s;
  }
  .addon-card:hover { border-color: var(--glass-border-glow); box-shadow: var(--shadow-glow-accent); }
  .addon-name { font-family: var(--font-sans); font-size: var(--text-body); font-weight: var(--weight-medium); margin-bottom: var(--space-2xs); letter-spacing: 0; }
  .addon-price { font-family: var(--font-mono); font-size: var(--text-h3); font-weight: var(--weight-light); color: var(--accent); margin-bottom: var(--space-sm); }
  .addon-desc { font-size: var(--text-caption); color: var(--ink-dim); line-height: var(--leading-relaxed); }

  /* ── Checkout ───────────────────────── */
  .form-section { }
  .checkout-note {
    padding: var(--space-lg); border: 1px solid var(--border-hairline);
    font-size: var(--text-caption); color: var(--ink-dim);
    line-height: var(--leading-relaxed);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .checkout-note strong { font-weight: var(--weight-medium); color: var(--ink); }
  .checkout-error {
    margin-top: var(--space-md); padding: var(--space-md);
    border: 1px solid oklch(0.68 0.18 25 / 0.4);
    background: oklch(0.68 0.18 25 / 0.08);
    font-size: var(--text-caption); color: var(--rose);
    line-height: var(--leading-relaxed);
  }

  .delay-0 { transition-delay: 0s; }
  .delay-1 { transition-delay: 0.1s; }
  .delay-2 { transition-delay: 0.2s; }

  @media (max-width: 768px) {
    .addon-grid { grid-template-columns: 1fr; }
    .steps { flex-direction: column; gap: var(--space-sm); }
    .step-sep { display: none; }
  }
  @media (max-width: 600px) {
    .service { padding: var(--space-xl); }
    .micro { display: none; }
  }
</style>

<script>
  (function() {
    const buttons = document.querySelectorAll(".order-btn");
    const errorEl = document.getElementById("checkout-error");

    buttons.forEach(btn => {
      btn.addEventListener("click", async () => {
        const service = btn.dataset.service;
        if (!service) return;

        // Gather selected add-ons for this service
        const addonChecks = document.querySelectorAll(`input[data-service="${service}"]:checked`);
        const addons = Array.from(addonChecks).map((el: any) => el.value);

        btn.disabled = true;
        btn.textContent = "Redirecting to Stripe...";
        if (errorEl) errorEl.style.display = "none";

        try {
          const resp = await fetch("/api/checkout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ service, addons }),
          });

          const data = await resp.json();

          if (!resp.ok || !data.url) {
            throw new Error(data.error || "Could not start checkout.");
          }

          window.location.href = data.url;
        } catch (err) {
          btn.disabled = false;
          btn.textContent = btn.dataset.originalText || "Purchase";
          if (errorEl) {
            errorEl.style.display = "block";
            errorEl.textContent = err.message || "Something went wrong. Please try again or contact us.";
          }
        }
      });
    });
  })();
</script>
