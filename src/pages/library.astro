---
import Layout from '../layouts/Layout.astro';
import Head from '../components/Head.astro';
import videos from '../data/youtube.js';

const desc = 'Video essays and guided explorations. Full transcripts, timestamps, and companion materials for every release.';
---

<Layout title="Stilled | Library">
  <Head slot="head" title="Stilled | Library" description={desc} />

  <div class="mesh-layer" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
  </div>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="micro micro-tl" aria-hidden="true">LIBRARY</div>
  <div class="micro micro-tr" aria-hidden="true">{videos.length} VIDEOS</div>

  <section class="page">
    <header class="page-header reveal">
      <span class="mark" aria-hidden="true"></span>
      <h1>Library</h1>
      <p class="sub">{desc}</p>
    </header>

    <div class="video-list">
      {videos.map((v, i) => (
        <article class={`video-card reveal delay-${Math.min(i, 3)}`} id={`video-${v.id}`}>
          <div class="thumb-wrap">
            <img
              src={`https://img.youtube.com/vi/${v.id}/maxresdefault.jpg`}
              alt={v.title}
              loading="lazy"
              class="thumb"
            />
            <a
              href={`https://youtube.com/watch?v=${v.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="play-btn"
              aria-label="Watch on YouTube"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5,3 19,12 5,21"/></svg>
            </a>
            <span class="duration" aria-hidden="true">{v.duration}</span>
          </div>
          <div class="card-content">
            <div class="meta-row">
              <time datetime={v.date}>
                {new Date(v.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <a href={`/library/${v.id}`} class="video-link"><h2 class="video-title">{v.title}</h2></a>
            <div class="topics">
              {v.topics.map(t => <span class="topic-tag">{t}</span>)}
            </div>

            <a
              href={`https://youtube.com/watch?v=${v.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="watch-link"
            >Watch on YouTube →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  body { background: var(--paper-deep); color: var(--ink); overflow-x: hidden; }

  .mesh-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(130px); animation: drift 22s ease-in-out infinite; }
  .blob-1 { width: 45vw; height: 45vw; background: var(--mesh-1); top: -20%; left: -10%; animation-delay: 0s; }
  .blob-2 { width: 38vw; height: 38vw; background: var(--mesh-3); bottom: -10%; right: -15%; animation-delay: -8s; }
  @keyframes drift { 0%,100%{transform:translate(0,0) scale(1)} 25%{transform:translate(7%,-10%) scale(1.12)} 50%{transform:translate(-5%,7%) scale(0.9)} 75%{transform:translate(-9%,-5%) scale(1.06)} }

  .grid-lines { position: fixed; inset: 0; z-index: 1; pointer-events: none; background-image: linear-gradient(var(--border-hairline) 1px,transparent 1px),linear-gradient(90deg,var(--border-hairline) 1px,transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 50% 40% at 50% 50%,black 15%,transparent 60%); }

  .micro { position: fixed; z-index: var(--z-above); font-family: var(--font-mono,monospace); font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; opacity: 0.35; pointer-events: none; color: var(--ink-dim); }
  .micro-tl { top: 1.2rem; left: 1.5rem; }
  .micro-tr { top: 1.2rem; right: 1.5rem; }

  .page { padding: var(--page-pad-top) var(--page-pad-x) var(--page-pad-bottom); max-width: var(--measure-wide); margin: 0 auto; position: relative; z-index: 2; }
  .page-header { margin-bottom: var(--space-3xl); }
  .page-header .mark { display: block; width: 32px; height: 1px; background: var(--accent); margin-bottom: var(--space-lg); opacity: 0.5; }
  .page-header h1 { font-size: var(--text-display); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tightest); margin-bottom: var(--space-md); }
  .sub { font-size: var(--text-lead); color: var(--ink-dim); max-width: var(--measure-narrow); }

  /* ── Video List ─────────────────────── */
  .video-list { display: flex; flex-direction: column; gap: var(--space-2xl); }

  .video-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--border-hairline);
  }

  /* ── Thumbnail ──────────────────────── */
  .thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .video-card:hover .thumb { transform: scale(1.03); }
  .play-btn {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.35);
    opacity: 0; transition: opacity 0.35s;
    color: #fff;
  }
  .play-btn svg { width: 36px; height: 36px; }
  .video-card:hover .play-btn { opacity: 1; }
  .duration {
    position: absolute; bottom: 0.5rem; right: 0.5rem;
    background: rgba(0,0,0,0.75); color: #fff;
    font-size: 10px; font-family: var(--font-mono);
    padding: 0.15em 0.5em; letter-spacing: 0.06em;
  }

  /* ── Card Content ───────────────────── */
  .card-content { display: flex; flex-direction: column; }
  .meta-row time {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    opacity: 0.4;
  }
  .video-link { display: block; }
  .video-link:hover { opacity: 1; }
  .video-link:hover .video-title { opacity: 0.7; }
  .video-title {
    font-size: var(--text-h2);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-sm) 0 var(--space-sm);
    line-height: var(--leading-tight);
    transition: opacity 0.35s;
  }
  .topics {
    display: flex; flex-wrap: wrap; gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }
  .topic-tag {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    padding: 0.1em 0.6em;
  }

  /* ── Watch Link ─────────────────────── */
  .watch-link {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-size: var(--text-label); text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    font-weight: var(--weight-medium);
    padding-bottom: 0.25rem; border-bottom: 1px solid var(--accent);
    transition: opacity 0.35s, border-color 0.35s;
    margin-top: auto;
    width: fit-content;
  }
  .watch-link:hover { opacity: 0.7; border-color: transparent; }

  .delay-0 { transition-delay: 0s; }
  .delay-1 { transition-delay: 0.1s; }
  .delay-2 { transition-delay: 0.2s; }

  @media (max-width: 768px) {
    .video-card { grid-template-columns: 1fr; gap: var(--space-md); }
    .micro { display: none; }
  }
</style>
