---
import Layout from '../layouts/Layout.astro';
import Head from '../components/Head.astro';
import { getSyntheses } from '../data/syntheses.js';

const theories = await getSyntheses();
const desc = 'Precision instruments for the examined life. Forensic synthesis of consciousness, paradox, and identity.';
---

<Layout title="Stilled | Sanctum">
  <Head slot="head" title="Stilled | Sanctum" description={desc} />
  <link rel="stylesheet" href="/mouse-follower.css" />

  <!-- MESH GRADIENT BLOBS -->
  <div class="mesh-layer" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
  </div>

  <!-- GEOMETRIC GRID -->
  <div class="grid-lines" aria-hidden="true"></div>

  <!-- DENSITY: CORNER MICRO-TYPE -->
  <div class="micro micro-tl" aria-hidden="true">INDEX 01</div>
  <div class="micro micro-tr" aria-hidden="true">51°30′N 0°07′W</div>
  <div class="micro micro-bl" aria-hidden="true">SYS:OPERATIONAL</div>
  <div class="micro micro-br" aria-hidden="true">PRECISION · INSTRUMENTS</div>

  <!-- HERO — glass card on left, portrait right -->
  <section class="hero">
    <div class="hero-portrait" data-parallax="0.1">
      <img src="/portraits/dostoevsky.webp" alt="" aria-hidden="true" loading="eager" />
    </div>
    <div class="hero-glass">
      <div class="glass-card">
        <span class="mark" aria-hidden="true"></span>
        <h1 data-split="chars">Stilled.</h1>
        <p class="hero-lead" data-split="words">{desc}</p>
        <nav class="hero-nav">
          <a href="/theories" data-cursor-text="Theories">Theories</a>
          <a href="/directory" data-cursor-text="Directory">Directory</a>
          <a href="/artifacts" data-cursor-text="Artifacts">Artifacts</a>
          <a href="/counsel" data-cursor-text="Counsel">Counsel</a>
        </nav>
      </div>
    </div>
  </section>


	  <!-- ARCHIVE — external app link -->
	  <section class="archive-callout">
	    <a href="https://ai-os-alpha.vercel.app/" class="archive-card" target="_blank" rel="noopener noreferrer">
	      <span class="archive-label">Stilled. Archive</span>
	      <h2 class="archive-title">Tools, stories, and the examined life.</h2>
	      <p class="archive-desc">A private workspace for self-inquiry — your timeline, your patterns, your archive. Nothing harvested. Nothing sold.</p>
	      <span class="archive-cta">Open the Archive →</span>
	    </a>
	  </section>
  <!-- THEORIES -->
  {theories.length > 1 ? (
    <section class="horizontal-section" data-horizontal-pin>
      <header class="section-head">
        <span class="label">Theories</span>
        <h2 class="section-title">Recent Theories</h2>
        <span class="hint">Scroll →</span>
      </header>
      <div class="horizontal-track" data-horizontal-track>
        {theories.map((t) => (
          <a href={`/theories/${t.slug}`} class="glass-card-item" data-cursor-text="Read">
            {t.featureImage && (
              <div class="card-img" data-reveal-clip="up">
                <img src={t.featureImage} alt="" loading="lazy" />
              </div>
            )}
            <time class="card-date">
              {t.publishedAt ? new Date(t.publishedAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: '2-digit' }).replace(/,/g, '') : 'Synthesized'}
            </time>
            <h3 class="card-title">{t.title}</h3>
            <p class="card-blurb">{t.excerpt.slice(0, 100)}…</p>
            <span class="card-index">{String(theories.indexOf(t) + 1).padStart(2, '0')}</span>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <section class="fallback">
      <header class="section-head"><span class="label">Theories</span><h2 class="section-title">Recent Theories</h2></header>
      {theories.length === 1 ? (
        <a href={`/theories/${theories[0].slug}`} class="glass-card-item single"><h3>{theories[0].title}</h3><p>{theories[0].excerpt}</p></a>
      ) : (
        <p class="empty">No syntheses published yet.</p>
      )}
    </section>
  )}


  <!-- QUOTE — glass pull -->
  <section class="quote">
    <div class="quote-glass glass-card">
      <span class="label">Cogito</span>
      <blockquote data-split="words">
        "We do not manufacture meaning; we reveal the architecture where it already exists."
      </blockquote>
    </div>
  </section>

</Layout>

<style>
  body {
    background: var(--paper-deep);
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: var(--weight-light);
    overflow-x: hidden;
  }

  /* ── MESH GRADIENT BLOBS ──────────────── */
  .mesh-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob {
    position: absolute; border-radius: 50%; filter: blur(140px);
    animation: drift 24s ease-in-out infinite;
  }
  .blob-1 { width: 55vw; height: 55vw; background: var(--mesh-1); top: -25%; left: -10%; }
  .blob-2 { width: 45vw; height: 45vw; background: var(--mesh-2); top: 45%; right: -15%; animation-delay: -8s; }
  .blob-3 { width: 38vw; height: 38vw; background: var(--mesh-3); bottom: -15%; left: 25%; animation-delay: -16s; }
  .blob-4 { width: 30vw; height: 30vw; background: var(--mesh-4); top: 5%; right: 35%; animation-delay: -4s; }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25%      { transform: translate(10%, -15%) scale(1.18); }
    50%      { transform: translate(-6%, 10%) scale(0.88); }
    75%      { transform: translate(-12%, -6%) scale(1.1); }
  }

  /* ── GEOMETRIC GRID ───────────────────── */
  .grid-lines {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background-image:
      linear-gradient(var(--border-hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-hairline) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 55% 45% at 50% 50%, black 18%, transparent 65%);
  }

  /* ── MICRO TYPOGRAPHY ─────────────────── */
  .micro {
    position: fixed; z-index: var(--z-above);
    font-family: var(--font-mono, monospace);
    font-size: 9px; text-transform: uppercase;
    letter-spacing: 0.18em; opacity: 0.28;
    pointer-events: none; color: var(--ink-dim);
  }
  .micro-tl { top: 1.2rem; left: 1.5rem; }
  .micro-tr { top: 1.2rem; right: 1.5rem; }
  .micro-bl { bottom: 1.2rem; left: 1.5rem; }
  .micro-br { bottom: 1.2rem; right: 1.5rem; }

  /* ── GLASS CARD BASE ──────────────────── */
  .glass-card, .glass-card-item {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 2px;
    box-shadow: var(--shadow-float);
    position: relative;
  }
  .glass-card::after, .glass-card-item::after {
    content: '';
    position: absolute; inset: -1px; border-radius: 3px;
    padding: 1px;
    background: linear-gradient(135deg, var(--glass-border-glow), transparent 50%, var(--glass-border-glow) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    pointer-events: none; z-index: -1;
  }
  .glass-card-item:hover {
    border-color: var(--glass-border-glow);
    box-shadow: var(--shadow-glow-accent);
    transition: border-color 0.5s, box-shadow 0.5s;
  }

  /* ── HERO ─────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: [glass] 1fr [portrait] 1fr;
    grid-template-rows: 1fr;
    min-height: 90vh;
    align-items: start;
    margin-bottom: 10rem;
    position: relative; z-index: 2;
  }
  .hero-glass {
    grid-column: glass;
    grid-row: 1;
    padding: clamp(6rem, 10vh, 9rem) 0 0 clamp(2rem, 6vw, 4rem);
  }
  .hero-glass .glass-card {
    padding: clamp(2rem, 4vw, 3rem); max-width: 38rem;
  }
  .hero-glass .mark {
    display: block; width: 48px; height: 1px;
    background: var(--accent); margin-bottom: 1.5rem; opacity: 0.6;
  }
  .hero-glass h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: var(--weight-regular);
    line-height: 1.08; letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .hero-glass h1 span { display: inline-block; }
  .hero-lead {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.7; color: var(--ink-dim); margin-bottom: 2.5rem;
  }
  .hero-nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .hero-nav a {
    font-size: 0.6875rem; text-transform: uppercase;
    letter-spacing: 0.12em; opacity: 0.65;
    padding-bottom: 0.25rem; border-bottom: 1px solid transparent;
    transition: opacity 0.35s, border-color 0.35s;
  }
  .hero-nav a:hover { opacity: 1; border-color: var(--accent); }
  .hero-portrait {
    grid-column: portrait;
    grid-row: 1;
    min-height: 90vh; overflow: hidden; position: relative;
  }
  .hero-portrait img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%) contrast(1.15) brightness(0.65) saturate(0.45);
    mix-blend-mode: multiply; opacity: 0.25;
  }

  /* ── ARCHIVE CALLOUT ──────────────────── */
  .archive-callout {
    padding: 0 var(--page-pad-x);
    margin-bottom: var(--section-gap-lg);
    position: relative; z-index: 2;
  }
  .archive-card {
    display: block;
    border: 1px solid var(--accent-soft);
    padding: clamp(2rem, 4vw, 3rem);
    max-width: var(--measure-wide);
    transition: border-color 0.45s, box-shadow 0.45s, background 0.45s;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .archive-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-glow-accent);
    opacity: 1;
  }
  .archive-label {
    display: inline-block;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    padding: 0.15em 0.75em;
    margin-bottom: var(--space-md);
    font-weight: var(--weight-medium);
  }
  .archive-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-sm);
    color: var(--ink);
  }
  .archive-desc {
    font-size: var(--text-body);
    color: var(--ink-dim);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    max-width: var(--measure-base);
  }
  .archive-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    font-weight: var(--weight-medium);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--accent);
  }

  /* ── SECTION HEAD ─────────────────────── */
  .section-head { margin-bottom: 3rem; padding: 0 var(--page-pad-x); position: relative; z-index: 2; }
  .section-head .label {
    font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.18em;
    display: block; margin-bottom: 0.5rem; opacity: 0.6; color: var(--accent);
  }
  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: var(--weight-regular); letter-spacing: -0.015em;
  }
  .hint {
    display: inline-block; margin-top: 1rem;
    font-size: 0.6875rem; text-transform: uppercase;
    letter-spacing: 0.12em; opacity: 0.2; color: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:0.2} 50%{opacity:0.5} }

  /* ── HORIZONTAL SCROLL ────────────────── */
  .horizontal-section { overflow: hidden; margin-bottom: 12rem; position: relative; z-index: 2; }
  .horizontal-track {
    display: flex; gap: clamp(2rem, 5vw, 5rem);
    padding: 0 var(--page-pad-x) 3rem; width: max-content; will-change: transform;
  }
  .glass-card-item {
    display: block; width: clamp(320px, 45vw, 520px); flex-shrink: 0;
    padding: 2rem; transition: border-color 0.5s, box-shadow 0.5s, opacity 0.35s;
    position: relative; overflow: hidden;
  }
  .glass-card-item:hover { opacity: 0.9; }
  .card-img {
    width: 100%; aspect-ratio: 16/10; overflow: hidden;
    margin-bottom: 1.5rem; border-radius: 1px; will-change: clip-path;
  }
  .card-img img {
    width: 100%; height: 100%; object-fit: cover;
    border: 1px solid var(--border-hairline);
  }
  .card-date {
    font-size: 0.625rem; text-transform: uppercase;
    letter-spacing: 0.18em; opacity: 0.7; color: var(--accent);
    display: block; margin-bottom: 0.5rem;
  }
  .card-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: var(--weight-regular);
    letter-spacing: -0.015em; margin-bottom: 0.5rem;
  }
  .card-blurb { font-size: var(--text-body); color: var(--ink-dim); line-height: 1.6; }
  .card-index {
    position: absolute; top: 1rem; right: 1rem;
    font-family: var(--font-mono); font-size: 10px;
    opacity: 0.2; color: var(--accent);
  }

  /* ── FALLBACK ─────────────────────────── */
  .fallback { margin-bottom: 12rem; padding: 0 var(--page-pad-x); position: relative; z-index: 2; }
  .fallback .glass-card-item.single { max-width: 600px; padding: 2.5rem; }
  .fallback h3 { font-size: clamp(1.8rem,3vw,2.5rem); font-weight:var(--weight-regular); margin-bottom:.5rem; }
  .fallback p { color: var(--ink-dim); }
  .empty { color: var(--ink-dim); font-style: italic; }

  /* ── QUOTE ────────────────────────────── */
  .quote {
    min-height: 50vh; display: flex; align-items: center; justify-content: center;
    padding: 4rem var(--page-pad-x); margin-bottom: 6rem;
    position: relative; z-index: 2;
  }
  .quote-glass {
    padding: clamp(3rem, 6vw, 5rem); text-align: center;
    max-width: var(--measure-wide);
    margin: 0 auto;
  }
  .quote-glass .label { display: block; margin-bottom: 2rem; opacity: 0.25; }
  .quote-glass blockquote {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-style: italic; font-weight: var(--weight-regular);
    line-height: 1.2; color: var(--ink);
  }
  .quote-glass blockquote span { display: inline-block; }

  /* ── RESPONSIVE ───────────────────────── */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-glass { padding: 2rem var(--page-pad-x); align-self: auto; }
    .hero-glass .glass-card { max-width: none; }
    .hero-portrait { min-height: 35vh; order: -1; }
    .hero-portrait img { opacity: 0.12; }
  }
  @media (max-width: 600px) {
    .micro { display: none; }
    .horizontal-track .glass-card-item { width: 75vw; }
  }
</style>

<script>
  import '../scripts/immersive.js';
</script>
